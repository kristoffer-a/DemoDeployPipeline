          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5_34" value="&lt;b&gt;Why ComponentParameters&lt;/b&gt;&lt;br&gt;The import binds each connection reference to the existing TEST connection and sets each variable value &lt;b&gt;during&lt;/b&gt; the import, so no one signs in on deploy.&lt;br&gt;&lt;br&gt;&lt;b&gt;Connector quirks handled&lt;/b&gt;&lt;br&gt;· setProperty() rejects '.', so the flow writes odata_type and renames it to @odata.type as text.&lt;br&gt;· Dataverse unbound actions need item as one object.&lt;br&gt;· The import ZIP is managed; unmanaged customisations are not overwritten." style="whiteSpace=wrap;html=1;shape=note;size=14;fillColor=#FFFDE7;strokeColor=#C0A000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="990" y="120" width="420" height="260" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
