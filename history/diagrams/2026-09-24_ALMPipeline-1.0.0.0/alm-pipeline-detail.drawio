        <mxCell id="p7_title" value="7 · Roadmap (proposal, to refine): future child flows in C1's stage order" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="40" y="20" width="1400" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p7_sub" value="Green = live today. Dashed yellow = proposed. Each future child gets its own ALMConfig switch, like RunImport. The row under each stage says which platform and component it touches." style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;fontColor=#444444;" parent="1" vertex="1">
          <mxGeometry x="40" y="54" width="1400" height="40" as="geometry" />
        </mxCell>
