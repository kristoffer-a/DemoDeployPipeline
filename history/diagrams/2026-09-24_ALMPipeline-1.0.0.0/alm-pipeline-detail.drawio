        </mxCell>
        <mxCell id="p7_33" value="&lt;b&gt;Open items outside the roadmap&lt;/b&gt;&lt;br&gt;· Create TEST Products list → set dev_ProductsList&lt;br&gt;· Service account instead of kriall076&lt;br&gt;· PR feat/deploy-orchestrator → main" style="whiteSpace=wrap;html=1;shape=note;size=14;fillColor=#FFFDE7;strokeColor=#C0A000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" parent="1" vertex="1">
