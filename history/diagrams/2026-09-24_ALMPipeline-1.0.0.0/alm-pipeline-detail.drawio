          <mxGeometry x="40" y="160" width="180" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p7_2" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#038387&quot;&gt;&lt;b&gt;touches&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;SharePoint ALM-Admin lists · DEV Dataverse&lt;/font&gt;" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#333333;align=left;spacingLeft=8;strokeColor=#038387;" parent="1" vertex="1">
