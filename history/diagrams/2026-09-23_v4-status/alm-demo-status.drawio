        <mxCell id="s4" parent="1" vertex="1" value="&lt;b&gt;4. Canvas app&lt;/b&gt;&lt;br&gt;published in DEV&lt;br&gt;reads DEV Products" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;">
