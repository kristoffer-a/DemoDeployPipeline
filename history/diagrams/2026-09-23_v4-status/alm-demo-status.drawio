<mxfile host="app.diagrams.net" type="device">
  <diagram id="alm-demo-status" name="Demo status">
    <mxGraphModel grid="1" gridSize="10" page="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" vertex="1" value="ALM demo: what exists, what's next" style="text;html=1;fontSize=26;fontStyle=1;fontColor=#19354A;align=left;verticalAlign=middle;">
          <mxGeometry x="40" y="20" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="sub" parent="1" vertex="1" value="Scope: ADMIN / DEV / TEST only. Goal: Demo solution from DEV runs as managed in TEST, reading TEST data. As of 2026-09-23." style="text;html=1;fontSize=14;fontColor=#4A5A6A;align=left;verticalAlign=middle;whiteSpace=wrap;">
          <mxGeometry x="40" y="60" width="900" height="30" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="lg1" parent="1" vertex="1" value="Done in tenant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;">
          <mxGeometry x="960" y="20" width="130" height="28" as="geometry" />
        </mxCell>
        <mxCell id="lg2" parent="1" vertex="1" value="Next (you, in UI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;fontStyle=1;">
          <mxGeometry x="960" y="54" width="130" height="28" as="geometry" />
        </mxCell>
        <mxCell id="lg3" parent="1" vertex="1" value="Not started" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=12;">
          <mxGeometry x="1100" y="20" width="130" height="28" as="geometry" />
        </mxCell>
        <mxCell id="lg4" parent="1" vertex="1" value="Parked (out of scope)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;dashed=1;fontSize=12;fontColor=#B85450;">
          <mxGeometry x="1100" y="54" width="130" height="28" as="geometry" />
        </mxCell>

        <!-- Row 1: done -->
        <mxCell id="s1" parent="1" vertex="1" value="&lt;b&gt;1. Environments&lt;/b&gt;&lt;br&gt;ADMIN, DEV, TEST&lt;br&gt;created + Dataverse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;">
          <mxGeometry x="40" y="120" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" vertex="1" value="&lt;b&gt;2. SharePoint&lt;/b&gt;&lt;br&gt;ALM-Admin / Dev / Test sites&lt;br&gt;DEV Products: 3 rows&lt;br&gt;TEST Products: empty" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;">
          <mxGeometry x="270" y="120" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" vertex="1" value="&lt;b&gt;3. Demo solution 1.0.0.0&lt;/b&gt;&lt;br&gt;publisher dev&lt;br&gt;env vars: Site, List&lt;br&gt;conn ref: dev_SharePoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;">
          <mxGeometry x="500" y="120" width="190" height="80" as="geometry" />
