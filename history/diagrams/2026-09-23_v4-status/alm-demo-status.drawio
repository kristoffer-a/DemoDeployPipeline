        </mxCell>
        <mxCell id="s10" parent="1" vertex="1" value="&lt;b&gt;10. Verify&lt;/b&gt;&lt;br&gt;TEST app reads TEST data&lt;br&gt;DEV still reads DEV&lt;br&gt;= DEMO DONE" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=13;">
          <mxGeometry x="40" y="235" width="190" height="120" as="geometry" />
