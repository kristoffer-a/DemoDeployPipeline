        <mxCell id="e56" parent="1" edge="1" source="s5" target="s6" style="endArrow=block;html=1;strokeColor=#D79B00;strokeWidth=3;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e67" parent="1" edge="1" source="s6" target="s7" style="endArrow=block;html=1;strokeColor=#999999;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e78" parent="1" edge="1" source="s7" target="s8" style="endArrow=block;html=1;strokeColor=#999999;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e89" parent="1" edge="1" source="s8" target="s9" style="endArrow=block;html=1;strokeColor=#999999;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e910" parent="1" edge="1" source="s9" target="s10" style="endArrow=block;html=1;strokeColor=#999999;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Parked -->
        <mxCell id="parked" parent="1" vertex="1" value="&lt;b&gt;Parked — not needed for the demo&lt;/b&gt;&lt;br&gt;• ALMAdmin request/worker flows&lt;br&gt;• Operator UI&lt;br&gt;• JS helper model + 8 local tests&lt;br&gt;• Failure/timeout test matrix&lt;br&gt;• Prod / 4th environment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;dashed=1;fontSize=13;fontColor=#B85450;align=left;spacingLeft=10;">
          <mxGeometry x="270" y="400" width="420" height="120" as="geometry" />
        </mxCell>
        <mxCell id="effort" parent="1" vertex="1" value="&lt;b&gt;Where the work went&lt;/b&gt;&lt;br&gt;~40 docs in docs/alm, auth guard tooling,&lt;br&gt;reviews + handoffs. Tenant work = steps 1–5." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=13;fontColor=#19354A;align=left;spacingLeft=10;">
          <mxGeometry x="730" y="400" width="420" height="120" as="geometry" />
