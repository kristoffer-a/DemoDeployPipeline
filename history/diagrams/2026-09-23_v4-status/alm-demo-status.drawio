        </mxCell>
        <mxCell id="s8" parent="1" vertex="1" value="&lt;b&gt;8. Spike: export&lt;/b&gt;&lt;br&gt;Export Demo from DEV&lt;br&gt;(managed + unmanaged ZIP)&lt;br&gt;save to ALM-Admin site" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=13;">
          <mxGeometry x="500" y="250" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s9" parent="1" vertex="1" value="&lt;b&gt;9. Import to TEST&lt;/b&gt;&lt;br&gt;same managed ZIP&lt;br&gt;TEST Site/List values&lt;br&gt;TEST connection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=13;">
