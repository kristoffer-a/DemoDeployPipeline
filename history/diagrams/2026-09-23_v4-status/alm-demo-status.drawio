        <mxCell id="s5" parent="1" vertex="1" value="&lt;b&gt;5. New SP connection&lt;/b&gt;&lt;br&gt;shared-sharepointonl-4f3b8a9e&lt;br&gt;owner bosso, Connected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;">
          <mxGeometry x="960" y="120" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e12" parent="1" edge="1" source="s1" target="s2" style="endArrow=block;html=1;strokeColor=#82B366;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e23" parent="1" edge="1" source="s2" target="s3" style="endArrow=block;html=1;strokeColor=#82B366;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e34" parent="1" edge="1" source="s3" target="s4" style="endArrow=block;html=1;strokeColor=#82B366;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e45" parent="1" edge="1" source="s4" target="s5" style="endArrow=block;html=1;strokeColor=#82B366;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Row 2: next + remaining -->
        <mxCell id="s6" parent="1" vertex="1" value="&lt;b&gt;6. NEXT: Rebind dev_SharePoint&lt;/b&gt;&lt;br&gt;make.powerapps.com → DEV → Demo&lt;br&gt;→ Connection references&lt;br&gt;→ pick 4f3b8a9e → Save" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=3;fontSize=13;">
          <mxGeometry x="960" y="250" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s7" parent="1" vertex="1" value="&lt;b&gt;7. Flow in Demo&lt;/b&gt;&lt;br&gt;&quot;Demo - Get First Product&quot;&lt;br&gt;manual trigger → Get items&lt;br&gt;Top 1 → Compose" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=13;">
