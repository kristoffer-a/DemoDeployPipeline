        </mxCell>
        <mxCell id="n47" value="ACCESS IS CONFIGURED AT THREE SEPARATE LAYERS" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=16;fontColor=#7353AC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="75" y="814" width="810" height="25.6" />
        </mxCell>
        <mxCell id="n48" value="1   Environment group admits eligible users; roles control platform privileges.&#10;2   Business audience group receives app sharing / applicable flow run rights.&#10;3   SharePoint grants protect data; use role groups for finer segmentation." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=18;fontColor=#172B3A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="75" y="851" width="810" height="90.4" />
        </mxCell>
        <mxCell id="n49" value="* For eligible instant flows, a run-only user connection is an alternative. Check each trigger and connection setting." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=17;fontColor=#526775;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="989" width="1470" height="26.950000000000003" />
        </mxCell>
        <mxCell id="n50" value="A privileged flow must authorize each operation. UI filtering and a user-supplied email address are not sufficient controls." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=17;fontColor=#172B3A;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="1021" width="1470" height="26.950000000000003" />
        </mxCell>
        <mxCell id="n51" value="Solid arrows = runtime call or connection binding. Dashed arrows = configuration. Target variable values are supplied per environment.&#10;SharePoint OAuth canvas connections do not follow the flow connection-reference path. Sources and decisions: research note." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=16;fontColor=#526775;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="1059" width="1470" height="47.2" />
        </mxCell>
