        <mxCell id="n91" value="Guardrails: separate Prod identity where possible • no Dev/Test connection to Prod data • no routine edits in Test/Prod" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=17;fontColor=#172B3A;fontStyle=1;spacing=0;" vertex="1" parent="1">
