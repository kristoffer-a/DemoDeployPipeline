        </mxCell>
        <mxCell id="n92" value="SharePoint sites sit outside Power Platform environments. Managed solutions do not require Managed Environments.&#10;“Dev” is a lifecycle stage; use a suitable shared environment type. See the research note for prerequisites and limitations." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=16;fontColor=#526775;fontStyle=0;spacing=0;" vertex="1" parent="1">
