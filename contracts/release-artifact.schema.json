{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "ALM verified release artifact descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "solution",
    "solutionVersion",
    "managed",
    "cloudFlowIds",
    "zipSha256",
    "manifestSha256"
  ],
  "properties": {
    "version": {"type": "integer", "enum": [1]},
    "solution": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
    "solutionVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "managed": {"type": "boolean", "enum": [true]},
    "cloudFlowIds": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 100,
      "items": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}
    },
    "zipSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifestSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
