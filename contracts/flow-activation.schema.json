{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "ALM flow activation manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "solution", "flows"],
  "properties": {
    "version": {"type": "integer", "enum": [1]},
    "solution": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
    "flows": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workflowId", "enabled"],
        "properties": {
          "workflowId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
          "enabled": {"type": "boolean"}
        }
      }
    }
  }
}
