{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "alm_PipelineDataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      },
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "alm_PipelineSharePoint"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Button",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "text": {
                  "title": "Solution",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Solution unique name (default Demo)",
                  "x-ms-content-hint": "TEXT"
                },
                "text_1": {
                  "title": "Target",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "TEST or PROD (default TEST)",
                  "x-ms-content-hint": "TEXT"
                }
              },
              "required": []
            }
          }
        }
      },
      "actions": {
        "Solution": {
          "type": "Compose",
          "inputs": "@coalesce(triggerBody()?['text'], 'Demo')"
        },
        "Target": {
          "type": "Compose",
          "inputs": "@coalesce(triggerBody()?['text_1'], 'TEST')",
          "runAfter": {
            "Solution": [
              "Succeeded"
            ]
          }
        },
        "Init_FailMessage": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "FailMessage",
                "type": "string",
                "value": ""
              }
            ]
          },
          "runAfter": {
            "Target": [
              "Succeeded"
            ]
          }
        },
        "Main": {
          "type": "Scope",
          "actions": {
            "Prechecks": {
              "type": "Scope",
              "actions": {
                "Get_config": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "GetItems",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "https://7xpydh.sharepoint.com/sites/ALM-Admin",
                      "table": "049eba5a-700e-44db-9d2b-4e95c3af51b6",
                      "$filter": "SolutionName eq '@{outputs('Solution')}' and TargetEnvironment eq '@{outputs('Target')}'",
                      "$top": 1
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                },
                "Check_config": {
                  "type": "If",
                  "expression": {
                    "equals": [
                      "@empty(body('Get_config')?['value'])",
                      true
                    ]
                  },
                  "actions": {
                    "Set_Fail_no_config": {
                      "type": "SetVariable",
                      "inputs": {
                        "name": "FailMessage",
                        "value": "@concat('No ALMConfig row for ', outputs('Solution'), ' -> ', outputs('Target'))"
                      }
                    },
                    "Fail_no_config": {
                      "type": "Compose",
                      "inputs": "@int(variables('FailMessage'))",
                      "runAfter": {
                        "Set_Fail_no_config": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "runAfter": {
                    "Get_config": [
                      "Succeeded"
                    ]
                  }
                },
                "Config": {
                  "type": "Compose",
                  "inputs": "@first(body('Get_config')?['value'])",
                  "runAfter": {
                    "Check_config": [
                      "Succeeded"
                    ]
                  }
                },
                "Dev_url": {
                  "type": "Compose",
                  "inputs": "@outputs('Config')?['DevPowerPlatformUrl']",
                  "runAfter": {
                    "Config": [
                      "Succeeded"
                    ]
                  }
                },
                "Target_url": {
                  "type": "Compose",
                  "inputs": "@outputs('Config')?['TargetPowerPlatformUrl']",
                  "runAfter": {
                    "Dev_url": [
                      "Succeeded"
                    ]
                  }
                },
                "Get_connection_map": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "GetItems",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "https://7xpydh.sharepoint.com/sites/ALM-Admin",
                      "table": "bc640935-9503-44de-87d1-699d65c8d351",
                      "$filter": "Environment eq '@{outputs('Target')}'"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {
                    "Target_url": [
                      "Succeeded"
                    ]
                  }
                },
                "Get_variable_map": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "GetItems",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "https://7xpydh.sharepoint.com/sites/ALM-Admin",
                      "table": "1ffc8ca3-1458-423b-81cb-49226b41664f",
                      "$filter": "SolutionName eq '@{outputs('Solution')}' and Environment eq '@{outputs('Target')}'"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {
                    "Get_connection_map": [
                      "Succeeded"
                    ]
                  }
                },
                "Dev_refs": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "ListRecordsWithOrganization",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "organization": "@outputs('Dev_url')",
                      "entityName": "connectionreferences",
                      "fetchXml": "<fetch distinct=\"true\"><entity name=\"connectionreference\"><attribute name=\"connectionreferenceid\"/><attribute name=\"connectionreferencelogicalname\"/><link-entity name=\"solutioncomponent\" from=\"objectid\" to=\"connectionreferenceid\" link-type=\"inner\"><link-entity name=\"solution\" from=\"solutionid\" to=\"solutionid\" link-type=\"inner\"><filter><condition attribute=\"uniquename\" operator=\"eq\" value=\"@{outputs('Solution')}\"/></filter></link-entity></link-entity></entity></fetch>"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {
                    "Get_variable_map": [
                      "Succeeded"
                    ]
                  }
                },
                "Dev_ref_names": {
                  "type": "Select",
                  "inputs": {
                    "from": "@body('Dev_refs')?['value']",
                    "select": "@item()?['connectionreferencelogicalname']"
                  },
                  "runAfter": {
                    "Dev_refs": [
                      "Succeeded"
                    ]
                  }
                },
                "Dev_vars": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "ListRecordsWithOrganization",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "organization": "@outputs('Dev_url')",
                      "entityName": "environmentvariabledefinitions",
                      "fetchXml": "<fetch distinct=\"true\"><entity name=\"environmentvariabledefinition\"><attribute name=\"environmentvariabledefinitionid\"/><attribute name=\"schemaname\"/><link-entity name=\"solutioncomponent\" from=\"objectid\" to=\"environmentvariabledefinitionid\" link-type=\"inner\"><link-entity name=\"solution\" from=\"solutionid\" to=\"solutionid\" link-type=\"inner\"><filter><condition attribute=\"uniquename\" operator=\"eq\" value=\"@{outputs('Solution')}\"/></filter></link-entity></link-entity></entity></fetch>"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {
                    "Dev_ref_names": [
                      "Succeeded"
                    ]
                  }
                },
                "Dev_var_names": {
                  "type": "Select",
                  "inputs": {
                    "from": "@body('Dev_vars')?['value']",
                    "select": "@item()?['schemaname']"
                  },
                  "runAfter": {
                    "Dev_vars": [
                      "Succeeded"
                    ]
                  }
                },
                "Mapped_refs": {
                  "type": "Select",
                  "inputs": {
                    "from": "@body('Get_connection_map')?['value']",
                    "select": "@item()?['ConnectionReference']"
                  },
                  "runAfter": {
                    "Dev_var_names": [
                      "Succeeded"
                    ]
                  }
                },
                "Missing_refs": {
                  "type": "Query",
                  "inputs": {
                    "from": "@body('Dev_ref_names')",
                    "where": "@not(contains(body('Mapped_refs'), item()))"
                  },
                  "runAfter": {
                    "Mapped_refs": [
                      "Succeeded"
                    ]
                  }
                },
                "Mapped_vars": {
                  "type": "Select",
                  "inputs": {
                    "from": "@body('Get_variable_map')?['value']",
                    "select": "@item()?['SchemaName']"
                  },
                  "runAfter": {
                    "Missing_refs": [
                      "Succeeded"
                    ]
                  }
                },
                "Missing_vars": {
                  "type": "Query",
                  "inputs": {
                    "from": "@body('Dev_var_names')",
                    "where": "@not(contains(body('Mapped_vars'), item()))"
                  },
                  "runAfter": {
                    "Mapped_vars": [
                      "Succeeded"
                    ]
                  }
                },
                "Check_mappings": {
                  "type": "If",
                  "expression": {
                    "greater": [
                      "@add(length(body('Missing_refs')), length(body('Missing_vars')))",
                      0
                    ]
                  },
                  "actions": {
                    "Set_Fail_missing_mapping": {
                      "type": "SetVariable",
                      "inputs": {
                        "name": "FailMessage",
                        "value": "@concat('Missing mapping rows for ', outputs('Target'), ': ', join(union(body('Missing_refs'), body('Missing_vars')), ', '))"
                      }
                    },
                    "Fail_missing_mapping": {
                      "type": "Compose",
                      "inputs": "@int(variables('FailMessage'))",
                      "runAfter": {
                        "Set_Fail_missing_mapping": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "runAfter": {
                    "Missing_vars": [
                      "Succeeded"
                    ]
                  }
                }
              }
            },
            "Export": {
              "type": "Scope",
              "actions": {
                "Export_from_DEV": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "PerformUnboundActionWithOrganization",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "organization": "@outputs('Dev_url')",
                      "actionName": "ExportSolutionAsync",
                      "item": {
                        "SolutionName": "@outputs('Solution')",
                        "Managed": true
                      }
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                },
                "Export_Wait_for_job": {
                  "type": "Until",
                  "expression": "@equals(body('Export_Get_job')?['statecode'], 3)",
                  "limit": {
                    "count": 90,
                    "timeout": "PT30M"
                  },
                  "actions": {
                    "Export_Delay": {
                      "type": "Wait",
                      "inputs": {
                        "interval": {
                          "count": 20,
                          "unit": "Second"
                        }
                      }
                    },
                    "Export_Get_job": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps",
                          "operationId": "GetItemWithOrganization",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "organization": "@outputs('Dev_url')",
                          "entityName": "asyncoperations",
                          "recordId": "@body('Export_from_DEV')?['AsyncOperationId']",
                          "$select": "statecode,statuscode,message,friendlymessage"
                        },
                        "authentication": "@parameters('$authentication')"
                      },
                      "runAfter": {
                        "Export_Delay": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "runAfter": {
                    "Export_from_DEV": [
                      "Succeeded"
                    ]
                  }
                },
                "Export_succeeded": {
                  "type": "If",
                  "expression": {
                    "equals": [
                      "@body('Export_Get_job')?['statuscode']",
                      30
                    ]
                  },
                  "actions": {
                    "Download_export": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps",
                          "operationId": "PerformUnboundActionWithOrganization",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "organization": "@outputs('Dev_url')",
                          "actionName": "DownloadSolutionExportData",
                          "item": {
                            "ExportJobId": "@body('Export_from_DEV')?['ExportJobId']"
                          }
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    },
                    "Archive_ZIP": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_sharepointonline",
                          "operationId": "CreateFile",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                        },
                        "parameters": {
                          "dataset": "https://7xpydh.sharepoint.com/sites/ALM-Admin",
                          "folderPath": "/Solutions/@{outputs('Solution')}",
                          "name": "@{concat(outputs('Solution'), '_managed_', utcNow('yyyyMMdd-HHmmss'), '.zip')}",
                          "body": "@base64ToBinary(body('Download_export')?['ExportSolutionFile'])"
                        },
                        "authentication": "@parameters('$authentication')"
                      },
                      "runAfter": {
                        "Download_export": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Set_Fail_export": {
                        "type": "SetVariable",
                        "inputs": {
                          "name": "FailMessage",
                          "value": "@coalesce(body('Export_Get_job')?['friendlymessage'], body('Export_Get_job')?['message'], 'no message')"
                        }
                      },
                      "Fail_export": {
                        "type": "Compose",
                        "inputs": "@int(variables('FailMessage'))",
                        "runAfter": {
                          "Set_Fail_export": [
                            "Succeeded"
                          ]
                        }
                      }
                    }
                  },
                  "runAfter": {
                    "Export_Wait_for_job": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "runAfter": {
                "Prechecks": [
                  "Succeeded"
                ]
              }
            },
            "Import": {
              "type": "Scope",
              "actions": {
                "If_RunImport": {
                  "type": "If",
                  "expression": {
                    "equals": [
                      "@outputs('Config')?['RunImport']",
                      true
                    ]
                  },
                  "actions": {
                    "Run_C2_import": {
                      "type": "Workflow",
                      "inputs": {
                        "host": {
                          "workflowReferenceName": "0fb24d06-aab7-f111-aaae-000d3a832204"
                        },
                        "body": {
                          "text": "@body('Archive_ZIP')?['Path']",
                          "text_1": "@outputs('Solution')",
                          "text_2": "@outputs('Target')"
                        },
                        "retryPolicy": {
                          "type": "none"
                        }
                      }
                    },
                    "Check_C2": {
                      "type": "If",
                      "expression": {
                        "equals": [
                          "@body('Run_C2_import')?['status']",
                          "Succeeded"
                        ]
                      },
                      "actions": {},
                      "else": {
                        "actions": {
                          "Set_Fail_import": {
                            "type": "SetVariable",
                            "inputs": {
                              "name": "FailMessage",
                              "value": "@concat('Import: ', body('Run_C2_import')?['message'])"
                            }
                          },
                          "Fail_import": {
                            "type": "Compose",
                            "inputs": "@int(variables('FailMessage'))",
                            "runAfter": {
                              "Set_Fail_import": [
                                "Succeeded"
                              ]
                            }
                          }
                        }
                      },
                      "runAfter": {
                        "Run_C2_import": [
                          "Succeeded"
                        ]
                      }
                    }
                  }
                }
              },
              "runAfter": {
                "Export": [
                  "Succeeded"
                ]
              }
            },
            "PostImport": {
              "type": "Scope",
              "actions": {
                "If_RunPostImport": {
                  "type": "If",
                  "expression": {
                    "equals": [
                      "@outputs('Config')?['RunPostImport']",
                      true
                    ]
                  },
                  "actions": {
                    "Run_C3_post_import": {
                      "type": "Workflow",
                      "inputs": {
                        "host": {
                          "workflowReferenceName": "20b24d06-aab7-f111-aaae-000d3a832204"
                        },
                        "body": {
                          "text": "@outputs('Solution')",
                          "text_1": "@outputs('Target')"
                        },
                        "retryPolicy": {
                          "type": "none"
                        }
                      }
                    },
                    "Check_C3": {
                      "type": "If",
                      "expression": {
                        "equals": [
                          "@body('Run_C3_post_import')?['status']",
                          "Succeeded"
                        ]
                      },
                      "actions": {},
                      "else": {
                        "actions": {
                          "Set_Fail_post_import": {
                            "type": "SetVariable",
                            "inputs": {
                              "name": "FailMessage",
                              "value": "@concat('Post-import: ', body('Run_C3_post_import')?['message'])"
                            }
                          },
                          "Fail_post_import": {
                            "type": "Compose",
                            "inputs": "@int(variables('FailMessage'))",
                            "runAfter": {
                              "Set_Fail_post_import": [
                                "Succeeded"
                              ]
                            }
                          }
                        }
                      },
                      "runAfter": {
                        "Run_C3_post_import": [
                          "Succeeded"
                        ]
                      }
                    }
                  }
                }
              },
              "runAfter": {
                "Import": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Init_FailMessage": [
              "Succeeded"
            ]
          }
        },
        "Log": {
          "type": "Scope",
          "actions": {
            "Prechecks_failed": {
              "type": "Query",
              "inputs": {
                "from": "@result('Prechecks')",
                "where": "@equals(item()?['status'], 'Failed')"
              }
            },
            "Export_failed": {
              "type": "Query",
              "inputs": {
                "from": "@result('Export')",
                "where": "@equals(item()?['status'], 'Failed')"
              },
              "runAfter": {
                "Prechecks_failed": [
                  "Succeeded"
                ]
              }
            },
            "Import_failed": {
              "type": "Query",
              "inputs": {
                "from": "@result('Import')",
                "where": "@equals(item()?['status'], 'Failed')"
              },
              "runAfter": {
                "Export_failed": [
                  "Succeeded"
                ]
              }
            },
            "PostImport_failed": {
              "type": "Query",
              "inputs": {
                "from": "@result('PostImport')",
                "where": "@equals(item()?['status'], 'Failed')"
              },
              "runAfter": {
                "Import_failed": [
                  "Succeeded"
                ]
              }
            },
            "Log_entry": {
              "type": "Compose",
              "inputs": {
                "runId": "@{workflow()?['run']?['name']}",
                "solution": "@{outputs('Solution')}",
                "target": "@{outputs('Target')}",
                "status": "@{actions('Main')?['status']}",
                "zipPath": "@{actions('Archive_ZIP')?['outputs']?['body']?['Path']}",
                "switches": {
                  "RunImport": "@{actions('Config')?['outputs']?['RunImport']}",
                  "RunPostImport": "@{actions('Config')?['outputs']?['RunPostImport']}"
                },
                "message": "@{if(not(empty(variables('FailMessage'))), variables('FailMessage'), coalesce(coalesce(first(body('Prechecks_failed'))?['outputs']?['body']?['error']?['message'], first(body('Prechecks_failed'))?['error']?['message']), coalesce(first(body('Export_failed'))?['outputs']?['body']?['error']?['message'], first(body('Export_failed'))?['error']?['message']), coalesce(first(body('Import_failed'))?['outputs']?['body']?['error']?['message'], first(body('Import_failed'))?['error']?['message']), coalesce(first(body('PostImport_failed'))?['outputs']?['body']?['error']?['message'], first(body('PostImport_failed'))?['error']?['message']), if(equals(actions('Main')?['status'], 'Failed'), 'Deployment failed; see run history', '')))}",
                "steps": [
                  {
                    "step": "Prechecks",
                    "status": "@{actions('Prechecks')?['status']}",
                    "seconds": "@{div(sub(ticks(coalesce(actions('Prechecks')?['endTime'], utcNow())), ticks(coalesce(actions('Prechecks')?['startTime'], utcNow()))), 10000000)}",
                    "message": "@{if(equals(actions('Prechecks')?['status'], 'Failed'), if(not(empty(variables('FailMessage'))), variables('FailMessage'), coalesce(first(body('Prechecks_failed'))?['outputs']?['body']?['error']?['message'], first(body('Prechecks_failed'))?['error']?['message'])), '')}"
                  },
                  {
                    "step": "Export",
                    "status": "@{actions('Export')?['status']}",
                    "seconds": "@{div(sub(ticks(coalesce(actions('Export')?['endTime'], utcNow())), ticks(coalesce(actions('Export')?['startTime'], utcNow()))), 10000000)}",
                    "message": "@{if(equals(actions('Export')?['status'], 'Failed'), if(not(empty(variables('FailMessage'))), variables('FailMessage'), coalesce(first(body('Export_failed'))?['outputs']?['body']?['error']?['message'], first(body('Export_failed'))?['error']?['message'])), '')}"
                  },
                  {
                    "step": "Import",
                    "status": "@{if(and(equals(actions('Import')?['status'], 'Succeeded'), equals(actions('Config')?['outputs']?['RunImport'], False)), 'Skipped', actions('Import')?['status'])}",
                    "seconds": "@{div(sub(ticks(coalesce(actions('Import')?['endTime'], utcNow())), ticks(coalesce(actions('Import')?['startTime'], utcNow()))), 10000000)}",
                    "message": "@{if(equals(actions('Import')?['status'], 'Failed'), if(not(empty(variables('FailMessage'))), variables('FailMessage'), coalesce(first(body('Import_failed'))?['outputs']?['body']?['error']?['message'], first(body('Import_failed'))?['error']?['message'])), coalesce(actions('Run_C2_import')?['outputs']?['body']?['message'], ''))}"
                  },
                  {
                    "step": "PostImport",
                    "status": "@{if(and(equals(actions('PostImport')?['status'], 'Succeeded'), equals(actions('Config')?['outputs']?['RunPostImport'], False)), 'Skipped', actions('PostImport')?['status'])}",
                    "seconds": "@{div(sub(ticks(coalesce(actions('PostImport')?['endTime'], utcNow())), ticks(coalesce(actions('PostImport')?['startTime'], utcNow()))), 10000000)}",
                    "message": "@{if(equals(actions('PostImport')?['status'], 'Failed'), if(not(empty(variables('FailMessage'))), variables('FailMessage'), coalesce(first(body('PostImport_failed'))?['outputs']?['body']?['error']?['message'], first(body('PostImport_failed'))?['error']?['message'])), coalesce(actions('Run_C3_post_import')?['outputs']?['body']?['message'], ''))}"
                  }
                ]
              },
              "runAfter": {
                "PostImport_failed": [
                  "Succeeded"
                ]
              }
            },
            "Write_log": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "CreateFile",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "https://7xpydh.sharepoint.com/sites/ALM-Admin",
                  "folderPath": "/DeploymentLogs",
                  "name": "@{concat(outputs('Solution'), '_', outputs('Target'), '_', utcNow('yyyyMMdd-HHmmss'), '.json')}",
                  "body": "@{string(outputs('Log_entry'))}"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Log_entry": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Main": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          }
        },
        "Report_failure": {
          "type": "If",
          "expression": {
            "and": [
              {
                "equals": [
                  "@actions('Main')?['status']",
                  "Succeeded"
                ]
              },
              {
                "equals": [
                  "@actions('Log')?['status']",
                  "Succeeded"
                ]
              }
            ]
          },
          "actions": {},
          "else": {
            "actions": {
              "Stop_failed": {
                "type": "Terminate",
                "inputs": {
                  "runStatus": "Failed",
                  "runError": {
                    "code": "DeployStepFailed",
                    "message": "@{if(equals(actions('Main')?['status'], 'Succeeded'), 'Run log could not be written', outputs('Log_entry')?['message'])}"
                  }
                }
              }
            }
          },
          "runAfter": {
            "Log": [
              "Succeeded",
              "Failed"
            ]
          }
        }
      }
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}